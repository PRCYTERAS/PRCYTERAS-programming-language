// PRCYTERAS 0.10.7 — Hazır OBJ modelleri, ışık ve 3B sahne
// Derleme: pts cargo "Kod Ornegi 72 - Hazir 3B Varliklar.pts" --windowed --release
import Engine3D, File, System

fn main():
    Engine3D.init_window(1280, 720, "PRCYTERAS 3B Baslangic Kiti")
    auto asset = File.parent(System.executable_path()) + "\\assets\\starter3d\\"
    int hero = Engine3D.load_obj(asset + "adventurer.obj")
    int tree = Engine3D.load_obj(asset + "tree.obj")
    int coin = Engine3D.load_obj(asset + "coin.obj")
    int crystal = Engine3D.load_obj(asset + "crystal.obj")
    int crate = Engine3D.load_obj(asset + "crate.obj")
    Engine3D.set_camera(5.5, 4.0, 8.5, 0.0, 0.0, 0.0, 60.0)
    Engine3D.set_light(-0.4, -1.0, -0.3, 1.1)
    Engine3D.set_vsync(true)

    double angle = 0.0
    while Engine3D.is_running():
        double dt = Engine3D.delta_time()
        angle += dt * 0.7
        if Engine3D.key_down("ESCAPE"):
            Engine3D.request_close()

        Engine3D.begin_frame(Color.rgb(17, 25, 44))
        Engine3D.draw_box(0.0, -0.85, 0.0, 9.0, 0.25, 5.0, Color.rgb(64, 104, 91))
        Engine3D.draw_model(hero, -1.7, 0.0, 0.0, 0.0, angle, 0.0, 1.0, Color.rgb(55, 186, 224))
        Engine3D.draw_model(tree, 1.6, -0.1, -0.4, 0.0, 0.0, 0.0, 1.0, Color.rgb(75, 196, 112))
        Engine3D.draw_model(coin, 0.0, 0.15, 1.5, 0.0, angle, 0.0, 0.9, Color.rgb(255, 194, 54))
        Engine3D.draw_model(crystal, 0.0, 0.0, -1.5, 0.0, angle, 0.0, 0.9, Color.rgb(104, 211, 255))
        Engine3D.draw_model(crate, 3.0, -0.15, 1.0, 0.0, 0.25, 0.0, 0.85, Color.rgb(179, 119, 72))
        Engine3D.end_frame()

    Engine3D.unload_model(hero)
    Engine3D.unload_model(tree)
    Engine3D.unload_model(coin)
    Engine3D.unload_model(crystal)
    Engine3D.unload_model(crate)
