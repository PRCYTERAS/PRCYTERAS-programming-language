// PRCYTERAS 0.10.8 — XAudio2 konumsal ses ornegi
// A/D ile dinleyiciyi saga/sola tasiyin. Ses kaynagi sahnede hareket eder.
// Derleme: pts cargo PRCYTERAS-3B-Konumsal-Ses.pts --windowed --release --portable

import Engine3D

fn main():
    Engine3D.init_window(1100, 650, "PRCYTERAS 3B Konumsal Ses")
    Engine3D.set_vsync(true)
    Engine3D.set_camera(0.0, 3.0, 10.0, 0.0, 1.0, 0.0, 60.0)
    Engine3D.set_light(-0.4, -1.0, -0.3, 1.0)
    Engine3D.set_master_volume(0.8)

    double dinleyici_x = 0.0
    double sonraki_ses = 0.0

    while Engine3D.is_running():
        double dt = Engine3D.delta_time()
        double zaman = Engine3D.time_seconds()
        if Engine3D.key_down("A"):
            dinleyici_x -= 3.0 * dt
        if Engine3D.key_down("D"):
            dinleyici_x += 3.0 * dt

        Engine3D.set_audio_listener(dinleyici_x, 1.5, 7.0, 0.0, -0.1, -1.0)
        double kaynak_x = 4.0 * Math.sin(zaman * 0.7)
        if zaman >= sonraki_ses:
            Engine3D.play_sound_3d("assets/starter3d/impact.wav", kaynak_x, 1.0, -2.0, 0.8, 18.0)
            sonraki_ses = zaman + 0.65

        Engine3D.begin_frame(Color.rgb(16, 23, 38))
        Engine3D.draw_box(0.0, -0.2, 0.0, 14.0, 0.4, 10.0, Color.rgb(58, 70, 82))
        Engine3D.draw_sphere(dinleyici_x, 1.0, 0.0, 0.45, Color.rgb(60, 190, 245))
        Engine3D.draw_sphere(kaynak_x, 1.0, -2.0, 0.35, Color.rgb(245, 110, 80))
        Engine3D.end_frame()
