// PRCYTERAS 0.10.7 — Hazır 2B varlıklar ve kare kare sprite animasyonu
// Derleme: pts cargo "Kod Ornegi 71 - Hazir 2B Varliklar.pts" --windowed --release
import Engine, UI, File, System

fn main():
    Engine.init_window(960, 540, "PRCYTERAS 2B Baslangic Kiti")
    Engine.set_target_fps(60)
    auto asset = File.parent(System.executable_path()) + "\\assets\\starter2d\\"
    auto background = asset + "adventure_background.png"
    auto hero_sheet = asset + "adventurer_sheet.png"
    auto coin = asset + "coin.png"
    auto slime = asset + "slime.png"
    auto platform = asset + "platform.png"
    auto heart = asset + "heart.png"

    double x = 140.0
    double y = 345.0
    double animation_timer = 0.0
    int frame = 0

    while Engine.is_running():
        double dt = Engine.delta_time()
        if Engine.key_down("A") or Engine.key_down("LEFT"):
            x -= 220.0 * dt
        if Engine.key_down("D") or Engine.key_down("RIGHT"):
            x += 220.0 * dt
        if Engine.key_down("ESCAPE"):
            Engine.request_close()

        if x < 10.0:
            x = 10.0
        if x > 880.0:
            x = 880.0

        animation_timer += dt
        if animation_timer >= 0.12:
            animation_timer = 0.0
            frame += 1
            if frame >= 4:
                frame = 0

        Engine.clear_screen(Color.BLACK)
        Engine.draw_image(background, 0, 0, 960, 540)
        Engine.draw_image(platform, 0, 465, 960, 40)
        Engine.draw_image(platform, 250, 350, 220, 30)
        Engine.draw_image(platform, 570, 285, 210, 30)
        Engine.draw_image(coin, 320, 300, 48, 48)
        Engine.draw_image(coin, 650, 235, 48, 48)
        Engine.draw_image(slime, 690, 420, 72, 58)
        Engine.draw_sprite_frame(hero_sheet, frame, 64, 64, x, y, 64, 64)
        Engine.draw_image(heart, 24, 20, 36, 34)
        UI.draw_text("PRCYTERAS 2B BASLANGIC KITI", 70, 24, 24, Color.WHITE)
        UI.draw_text("A/D veya ok tuslari: hareket    ESC: cikis", 24, 500, 18, Color.WHITE)
        Engine.render_frame()

    Engine.clear_image_cache()
