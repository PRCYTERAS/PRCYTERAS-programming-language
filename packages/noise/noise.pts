import Noise

fn perlin2(x, y, seed):
    return Noise.perlin2(x, y, seed)
fn perlin3(x, y, z, seed):
    return Noise.perlin3(x, y, z, seed)
fn simplex2(x, y, seed):
    return Noise.simplex2(x, y, seed)
fn worley2(x, y, seed):
    return Noise.worley2(x, y, seed)
fn fbm2(x, y, octaves, persistence, seed):
    return Noise.fbm2(x, y, octaves, persistence, seed)
