// Gercek OpenAI HTTP API istemcisi. API anahtari gerekir.
import OpenAi

fn chat(api_key, model, messages, temperature, max_tokens, base_url):
    return OpenAi.chat(api_key, model, messages, temperature, max_tokens, base_url)

fn models(api_key, base_url):
    return OpenAi.models(api_key, base_url)
